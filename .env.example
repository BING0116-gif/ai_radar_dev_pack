# AI Radar 环境变量示例
# 使用方法：复制本文件为 .env 放在仓库根目录，并填写实际值。
# 安全要求：禁止将真实密钥提交到 Git；.env 已由 .gitignore 排除。
# 说明：除 LLM_API_KEY 为敏感字段（日志中自动脱敏）外，其余均可留空使用默认值。

# 运行环境：development / production
APP_ENV=development

# 数据库连接（默认 SQLite，Demo 用）
DATABASE_URL=sqlite:///./ai_radar.db

# LLM 配置（OpenAI 兼容 Function Calling）
# 留空时开发环境仍可启动；Agent 真正运行时需要填写真实值
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Agent 与工具
WORKSPACE_ROOT=workspace
AGENT_MAX_STEPS=12
TOOL_TIMEOUT_SECONDS=10

# 定时器（生产开启后重启按配置重建，dev 默认关闭）
SCHEDULER_ENABLED=false
SCHEDULER_DAILY_HOUR=9
SCHEDULER_DAILY_MINUTE=0

# 邮件通知（可选；凭据仅从环境变量读取，禁止入库）
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=